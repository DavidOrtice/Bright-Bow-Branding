---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio | Ateliér Bespoke">
  <nav class="p-8 flex justify-between items-center bg-white border-b border-gray-100">
    <a href="/" class="text-xl font-serif tracking-tighter uppercase text-black">Ateliér</a>
    <div class="space-x-6 text-[10px] tracking-widest uppercase">
      <a href="/" class="text-gray-400">Home</a>
      <a href="/journal" class="text-gray-400">Journal</a>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-6 py-24">
    <header class="mb-20">
      <h1 class="text-6xl font-serif italic text-[#1a1a1a]">Selected Works</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="space-y-4">
        <div class="aspect-[4/5] bg-gray-100 overflow-hidden">
          <img src="/wedding-stationery-nairobi.jpg" alt="Wedding Suite" class="w-full h-full object-cover" />
        </div>
        <p class="font-serif text-2xl italic">The Mauve Wedding Suite</p>
        <p class="text-[10px] uppercase tracking-widest text-gray-400">Event Branding</p>
      </div>

      <div class="space-y-4">
        <div class="aspect-[4/5] bg-gray-100 overflow-hidden">
          <img src="/corporate-gifts-kenya.jpg" alt="Corporate Gifting" class="w-full h-full object-cover" />
        </div>
        <p class="font-serif text-2xl italic">Executive Identity</p>
        <p class="text-[10px] uppercase tracking-widest text-gray-400">Corporate Gifting</p>
      </div>
    </div>
  </main>
</Layout>
