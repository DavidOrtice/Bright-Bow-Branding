---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow Branding | Vivid Design & Printing">
  <nav class="fixed top-0 w-full z-50 bg-white border-b border-gray-100 px-6 md:px-24 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 flex">
        <div style="background-color: #0047AB;" class="w-1/2 h-full"></div> <div style="background-color: #FF4500;" class="w-1/2 h-full"></div> </div>
      <span class="text-xl font-black tracking-tighter text-black uppercase">Bright Bow</span>
    </div>
    
    <div class="hidden md:flex space-x-8 text-[11px] font-black uppercase tracking-widest text-gray-500">
      <a href="#services" class="hover:text-blue-600 transition">Services</a>
      <a href="#work" class="hover:text-blue-600 transition">Portfolio</a>
      <a href="#contact" style="background-color: #0047AB;" class="text-white px-5 py-2 rounded-sm shadow-lg shadow-blue-200">Start Project</a>
    </div>
  </nav>

  <main>
    <section id="home" class="pt-48 pb-24 px-6 md:px-24 bg-white">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-6xl md:text-[90px] font-black leading-[0.85] tracking-tighter text-black uppercase mb-8">
            Vivid <br/> 
            <span style="color: #0047AB;">Printing.</span> <br/> 
            <span style="color: #FF4500;">Branding.</span>
          </h1>
          <p class="text-xl font-bold text-gray-400 max-w-lg mb-10 uppercase tracking-tight">
            We bring color to your business identity.
          </p>
          <a href="#services" class="inline-block border-4 border-black px-10 py-4 font-black uppercase tracking-widest hover:bg-black hover:text-white transition">Explore Our Work</a>
        </div>
        
        <div class="grid grid-cols-2 gap-2 max-w-md mx-auto md:mx-0">
          <div style="background-color: #0047AB;" class="aspect-square rounded-tl-[80px]"></div> <div style="background-color: #FF4500;" class="aspect-square"></div> <div style="background-color: #FFD700;" class="aspect-square"></div> <div style="background-color: #E11D48;" class="aspect-square rounded-br-[80px]"></div> </div>
      </div>
    </section>

    <section id="services" class="py-20 px-6 md:px-24 bg-white scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-white font-black uppercase">
        <div style="background-color: #0047AB;" class="p-10 h-80 flex flex-col justify-end">
          <span class="text-xs mb-2 opacity-70">01</span>
          <h3 class="text-3xl">Visual<br/>Identity</h3>
        </div>
        <div style="background-color: #FF4500;" class="p-10 h-80 flex flex-col justify-end">
          <span class="text-xs mb-2 opacity-70">02</span>
          <h3 class="text-3xl">Premium<br/>Printing</h3>
        </div>
        <div style="background-color: #FFD700;" class="p-10 h-80 flex flex-col justify-end text-black">
          <span class="text-xs mb-2 opacity-40">03</span>
          <h3 class="text-3xl">Strategic<br/>Design</h3>
        </div>
        <div style="background-color: #E11D48;" class="p-10 h-80 flex flex-col justify-end">
          <span class="text-xs mb-2 opacity-70">04</span>
          <h3 class="text-3xl">Custom<br/>Gifts</h3>
        </div>
      </div>
    </section>

    <section id="work" class="py-32 px-6 md:px-24 bg-gray-50 scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-6">
          <div class="aspect-video bg-gray-200 overflow-hidden border-[16px] border-white shadow-xl">
            <img src="/wedding-stationery-nairobi.jpg" class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700" />
          </div>
          <h4 class="text-2xl font-black uppercase italic tracking-tighter">Selected Works / 01</h4>
        </div>
        <div class="space-y-6 md:mt-24">
          <div class="aspect-video bg-gray-200 overflow-hidden border-[16px] border-white shadow-xl">
            <img src="/corporate-gifts-kenya.jpg" class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700" />
          </div>
          <h4 class="text-2xl font-black uppercase italic tracking-tighter">Selected Works / 02</h4>
        </div>
      </div>
    </section>

    <section id="contact" style="background-color: #FF4500;" class="py-32 px-6 md:px-24 text-center">
      <h2 class="text-6xl md:text-[120px] font-black uppercase tracking-tighter mb-12 text-white leading-none">Ready to <br/> go Bright?</h2>
      <a href="https://wa.me/254..." class="inline-block bg-white text-black px-12 py-6 text-xl font-black uppercase tracking-widest hover:scale-110 transition-transform shadow-2xl">Start Your Project</a>
    </section>
  </main>

  <footer class="p-12 text-center text-[10px] font-black uppercase tracking-[0.4em] text-gray-400">
    © 2026 Bright Bow Branding & Printing • Nairobi, Kenya.
  </footer>
</Layout>
