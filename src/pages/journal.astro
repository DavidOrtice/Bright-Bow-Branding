---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Journal | Ateliér Bespoke">
	<nav class="p-8 flex justify-between items-center bg-white">
		<a href="/" class="text-xl font-serif tracking-tighter uppercase">Ateliér</a>
		<a href="/" class="text-[10px] tracking-widest uppercase text-gray-400">Back to Home</a>
	</nav>

	<main class="max-w-4xl mx-auto px-6 py-24">
		<header class="mb-20 text-center">
			<span class="text-[10px] uppercase tracking-[0.4em] text-gray-400 block mb-4">Volume 01</span>
			<h1 class="text-5xl md:text-7xl font-serif italic leading-tight text-[#1a1a1a]">
				The Art of the Tangible.
			</h1>
		</header>

		<article class="prose prose-stone mx-auto">
			<div class="aspect-[16/9] overflow-hidden mb-12 bg-gray-100">
				<img src="/wedding-stationery-nairobi.jpg" alt="Stationery detail" class="w-full h-full object-cover grayscale" />
			</div>
			
			<div class="max-w-2xl mx-auto text-lg font-light leading-relaxed text-gray-700">
				<p class="mb-8">
					In an era defined by the digital, the weight of a 300gsm cotton cardstock speaks louder than a thousand emails. At Ateliér, we believe in the authority of the physical.
				</p>
			</div>
		</article>
	</main>
</Layout>
