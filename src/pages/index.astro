---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow | Premium Branding & Printing">
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap');
		
		:root {
			--primary-blue: #0047AB; /* Royal Blue */
			--accent-orange: #FF4500; /* Safety Orange */
			--accent-pink: #E11D48; /* Magenta */
			--accent-gold: #FFD700; /* Lemon Yellow */
			--dark: #0a0a0a;
			--gray: #6b7280;
		}

		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: 'Plus Jakarta Sans', sans-serif; background: #ffffff; color: var(--dark); overflow-x: hidden; }
		html { scroll-behavior: smooth; }

		/* --- Navigation --- */
		.nav {
			position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
			background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
			border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		}
		.nav-container {
			max-width: 1400px; margin: 0 auto; padding: 1rem 2rem;
			display: flex; justify-content: space-between; align-items: center;
		}

		/* --- The CSS-Coded Logo --- */
		.logo { display: flex; align-items: center; gap: 15px; text-decoration: none; }
		.logo-mark {
			display: grid; grid-template-columns: repeat(2, 20px);
			grid-template-rows: repeat(2, 20px); gap: 2px;
		}
		.tile { width: 20px; height: 20px; }
		.blue { background: var(--primary-blue); border-radius: 10px 0 0 0; } /* Round top-left */
		.orange { background: var(--accent-orange); }
		.yellow { background: var(--accent-gold); }
		.magenta { background: var(--accent-pink); border-radius: 0 0 10px 0; } /* Round bottom-right */
		
		.logo-text-group { display: flex; flex-direction: column; }
		.brand-name { font-weight: 800; font-size: 1.2rem; line-height: 1; letter-spacing: -0.5px; color: var(--dark); }
		.brand-name span { color: var(--primary-blue); }
		.tagline { font-size: 0.5rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); margin-top: 2px; }

		/* --- Hero Section --- */
		.hero {
			min-height: 100vh; display: flex; align-items: center;
			padding: 8rem 2rem 4rem; position: relative; overflow: hidden;
		}
		.hero-content { max-width: 800px; z-index: 2; animation: fadeInUp 0.8s ease-out; }
		@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
		
		.hero-title { font-size: clamp(3rem, 7vw, 6rem); font-weight: 800; line-height: 0.9; letter-spacing: -3px; margin-bottom: 2rem; }
		.hero-title span { color: var(--primary-blue); }
		.hero-subtitle { font-family: 'Crimson Pro', serif; font-size: 1.5rem; color: var(--gray); font-style: italic; margin-bottom: 3rem; }

		.cta-primary {
			background: var(--accent-orange); color: white; padding: 1.2rem 2.5rem;
			border-radius: 50px; text-decoration: none; font-weight: 700;
			display: inline-block; transition: 0.3s; box-shadow: 0 10px 20px rgba(255, 69, 0, 0.2);
		}
		.cta-primary:hover { transform: translateY(-3px); background: #e63e00; }

		/* --- Services --- */
		.services { padding: 100px 5%; background: #f9f9f9; }
		.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
		.service-card { background: white; padding: 40px; border-radius: 20px; border-bottom: 5px solid transparent; transition: 0.3s; }
		.service-card:hover { transform: translateY(-10px); }
		.s1 { border-color: var(--primary-blue); }
		.s2 { border-color: var(--accent-orange); }
		.s3 { border-color: var(--accent-pink); }
		.service-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 15px; }
		
		/* --- Footer --- */
		.footer { padding: 60px 2rem; background: var(--dark); color: white; text-align: center; }
		.footer-copy { opacity: 0.5; font-size: 0.8rem; margin-top: 20px; }

		@media (max-width: 768px) {
			.nav-links { display: none; }
			.hero-title { font-size: 3.5rem; }
		}
	</style>

	<nav class="nav">
		<div class="nav-container">
			<a href="#" class="logo">
				<div class="logo-mark">
					<div class="tile blue"></div>
					<div class="tile orange"></div>
					<div class="tile yellow"></div>
					<div class="tile magenta"></div>
				</div>
				<div class="logo-text-group">
					<span class="brand-name">BRIGHT <span>BOW</span></span>
					<span class="tagline">Branding & Printing</span>
				</div>
			</a>
			<div style="display: flex; gap: 30px; align-items: center;">
				<a href="#services" style="text-decoration: none; color: var(--gray); font-weight: 700; font-size: 0.9rem;">SERVICES</a>
				<a href="https://wa.me/254..." class="cta-primary" style="padding: 0.8rem 1.5rem; font-size: 0.8rem;">GET STARTED</a>
			</div>
		</div>
	</nav>

	<section class="hero">
		<div class="hero-content">
			<h1 class="hero-title">
				Vivid Identity.<br>
				<span>Precision</span> Print.
			</h1>
			<p class="hero-subtitle">
				Crafting visual landmarks from Nairobi to the world. We build brands that command attention and inspire confidence.
			</p>
			<a href="https://wa.me/254..." class="cta-primary">Start Your Project →</a>
		</div>
		
		<div style="position: absolute; right: -5%; bottom: 10%; width: 40vw; height: 40vw; background: var(--primary-blue); opacity: 0.03; border-radius: 100px 0 100px 100px; z-index: 1;"></div>
	</section>

	<section id="services" class="services">
		<div class="services-grid">
			<div class="service-card s1">
				<h3 class="service-title" style="color: var(--primary-blue);">Brand Identity</h3>
				<p style="color: var(--gray); line-height: 1.6;">Architecture of visual systems for growing enterprises and elite institutions.</p>
			</div>
			<div class="service-card s2">
				<h3 class="service-title" style="color: var(--accent-orange);">Premium Printing</h3>
				<p style="color: var(--gray); line-height: 1.6;">High-fidelity production with meticulous attention to bespoke materials and finishes.</p>
			</div>
			<div class="service-card s3">
				<h3 class="service-title" style="color: var(--accent-pink);">Strategic Design</h3>
				<p style="color: var(--gray); line-height: 1.6;">Consultancy for brand positioning in competitive markets across East Africa.</p>
			</div>
		</div>
	</section>

	<footer class="footer">
		<div class="logo" style="justify-content: center; margin-bottom: 20px;">
			<div class="logo-mark">
				<div class="tile blue"></div>
				<div class="tile orange"></div>
				<div class="tile yellow"></div>
				<div class="tile magenta"></div>
			</div>
		</div>
		<p style="font-weight: 800; letter-spacing: 2px;">BRIGHT BOW BRANDING</p>
		<p class="footer-copy">© 2026 Bright Bow Branding & Printing. All Rights Reserved.</p>
	</footer>
</Layout>
