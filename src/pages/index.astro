---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow | Premium Branding & Printing">
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap');
		
		:root {
			--primary-blue: #0047AB; /* Royal Blue */
			--accent-orange: #FF4500; /* Safety Orange */
			--accent-pink: #E11D48; /* Magenta */
			--accent-gold: #FFD700; /* Lemon Yellow */
			--dark: #0a0a0a;
			--gray: #6b7280;
			--soft-bg: #fcfcfc;
		}

		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--soft-bg); color: var(--dark); overflow-x: hidden; }
		html { scroll-behavior: smooth; }

		/* --- Refined Navigation --- */
		.nav {
			position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
			background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(15px);
			border-bottom: 1px solid rgba(0, 0, 0, 0.05);
		}
		.nav-container {
			max-width: 1400px; margin: 0 auto; padding: 1.2rem 2rem;
			display: flex; justify-content: space-between; align-items: center;
		}

		/* --- The Brand-Correct CSS Logo --- */
		.logo { display: flex; align-items: center; gap: 14px; text-decoration: none; }
		.logo-mark {
			display: grid; grid-template-columns: repeat(2, 20px);
			grid-template-rows: repeat(2, 20px); gap: 3px;
		}
		.tile { width: 20px; height: 20px; transition: transform 0.3s ease; }
		.blue { background: var(--primary-blue); border-radius: 10px 0 0 0; }
		.orange { background: var(--accent-orange); }
		.yellow { background: var(--accent-gold); }
		.magenta { background: var(--accent-pink); border-radius: 0 0 10px 0; }
		
		.logo:hover .tile { transform: scale(1.1); }
		
		.logo-text-group { display: flex; flex-direction: column; }
		.brand-name { font-weight: 800; font-size: 1.25rem; line-height: 1; letter-spacing: -0.5px; color: var(--dark); }
		.brand-name span { color: var(--primary-blue); }
		.tagline { font-size: 0.55rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--gray); margin-top: 4px; }

		/* --- Hero Section: The "Modern Agency" Look --- */
		.hero {
			min-height: 90vh; display: flex; align-items: center;
			padding: 8rem 5% 4rem; position: relative;
		}
		.hero-content { max-width: 900px; z-index: 2; animation: fadeInUp 0.8s ease-out; }
		@keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
		
		.hero-title { font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 800; line-height: 0.85; letter-spacing: -4px; margin-bottom: 2.5rem; }
		.hero-title span { color: var(--primary-blue); }
		
		.hero-subtitle { 
			font-family: 'Crimson Pro', serif; font-size: clamp(1.2rem, 2vw, 1.8rem); 
			color: var(--gray); font-style: italic; margin-bottom: 3.5rem; max-width: 700px;
			line-height: 1.4;
		}

		.cta-group { display: flex; gap: 20px; flex-wrap: wrap; }
		.cta-primary {
			background: var(--accent-orange); color: white; padding: 1.2rem 2.8rem;
			border-radius: 4px; text-decoration: none; font-weight: 800;
			text-transform: uppercase; letter-spacing: 1px; font-size: 0.9rem;
			transition: 0.3s; box-shadow: 0 10px 25px rgba(255, 69, 0, 0.2);
		}
		.cta-primary:hover { transform: translateY(-3px); background: #e63e00; box-shadow: 0 15px 30px rgba(255, 69, 0, 0.3); }

		/* --- Services: Structural & Bold --- */
		.services { padding: 120px 5%; background: #ffffff; }
		.section-header { margin-bottom: 60px; }
		.section-label { font-weight: 800; font-size: 0.75rem; color: var(--accent-pink); letter-spacing: 4px; text-transform: uppercase; }
		
		.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }
		.service-card { 
			padding: 50px; border: 1px solid #eee; border-radius: 2px; 
			transition: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
			position: relative; overflow: hidden;
		}
		.service-card:hover { border-color: var(--dark); transform: translateY(-5px); }
		.service-card::after {
			content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 4px;
			transition: 0.4s;
		}
		.s1:hover::after { width: 100%; background: var(--primary-blue); }
		.s2:hover::after { width: 100%; background: var(--accent-orange); }
		.s3:hover::after { width: 100%; background: var(--accent-pink); }

		.service-title { font-size: 1.8rem; font-weight: 800; margin-bottom: 20px; letter-spacing: -0.5px; }

		/* --- Footer --- */
		.footer { padding: 80px 5%; background: var(--dark); color: white; }
		.footer-grid { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 40px; }
		.footer-copy { opacity: 0.4; font-size: 0.75rem; letter-spacing: 1px; }

		@media (max-width: 768px) {
			.hero-title { font-size: 3.8rem; }
			.nav-container { padding: 1rem; }
		}
	</style>

	<nav class="nav">
		<div class="nav-container">
			<a href="#" class="logo">
				<div class="logo-mark">
					<div class="tile blue"></div>
					<div class="tile orange"></div>
					<div class="tile yellow"></div>
					<div class="tile magenta"></div>
				</div>
				<div class="logo-text-group">
					<span class="brand-name">BRIGHT <span>BOW</span></span>
					<span class="tagline">Branding & Printing</span>
				</div>
			</a>
			<div style="display: flex; gap: 20px; align-items: center;">
				<a href="https://wa.me/254..." class="cta-primary" style="padding: 0.7rem 1.4rem; font-size: 0.75rem; box-shadow: none;">WhatsApp Us</a>
			</div>
		</div>
	</nav>

	<section class="hero">
		<div class="hero-content">
			<h1 class="hero-title">
				Modern Design.<br>
				<span>High-End</span> Print.
			</h1>
			<p class="hero-subtitle">
				Premium visual identity systems and precision production for businesses that demand excellence. Based in Nairobi, serving the world.
			</p>
			<div class="cta-group">
				<a href="#services" class="cta-primary">Explore Services</a>
				<a href="mailto:hello@brightbow.co.ke" style="color: var(--dark); font-weight: 800; text-decoration: none; padding: 1.2rem 0; border-bottom: 2px solid var(--dark);">Drop an Email →</a>
			</div>
		</div>
		
		<div style="position: absolute; right: -5%; top: 20%; width: 45vw; height: 45vw; background: var(--primary-blue); opacity: 0.02; border-radius: 150px 0 0 150px; z-index: 1;"></div>
	</section>

	<section id="services" class="services">
		<div class="section-header">
			<span class="section-label">Expertise</span>
			<h2 style="font-size: 3rem; font-weight: 800; letter-spacing: -1.5px; margin-top: 10px;">The Bright Bow Way</h2>
		</div>
		<div class="services-grid">
			<div class="service-card s1">
				<h3 class="service-title">Visual Identity</h3>
				<p style="color: var(--gray); line-height: 1.7;">Architecture of world-class logos and brand guidelines that define your market presence.</p>
			</div>
			<div class="service-card s2">
				<h3 class="service-title">Premium Print</h3>
				<p style="color: var(--gray); line-height: 1.7;">From luxury stationery to executive corporate gifts, we handle production with meticulous care.</p>
			</div>
			<div class="service-card s3">
				<h3 class="service-title">Brand Strategy</h3>
				<p style="color: var(--gray); line-height: 1.7;">Positioning your business for growth through research-driven creative consultancy.</p>
			</div>
		</div>
	</section>

	<footer class="footer">
		<div class="footer-grid">
			<div>
				<div class="logo-mark" style="margin-bottom: 25px; transform: scale(1.5); transform-origin: left;">
					<div class="tile blue"></div>
					<div class="tile orange"></div>
					<div class="tile yellow"></div>
					<div class="tile magenta"></div>
				</div>
				<p style="font-weight: 800; font-size: 1.5rem; letter-spacing: -0.5px;">BRIGHT BOW</p>
				<p style="opacity: 0.5; font-size: 0.9rem; margin-top: 10px;">Nairobi, Kenya</p>
			</div>
			<div style="text-align: right;">
				<div style="display: flex; gap: 30px; margin-bottom: 30px; justify-content: flex-end; font-weight: 700; font-size: 0.9rem;">
					<a href="#" style="color: white; text-decoration: none;">Services</a>
					<a href="#" style="color: white; text-decoration: none;">Portfolio</a>
					<a href="#" style="color: white; text-decoration: none;">Contact</a>
				</div>
				<p class="footer-copy">© 2026 BRIGHT BOW BRANDING & PRINTING. ALL RIGHTS RESERVED.</p>
			</div>
		</div>
	</footer>
</Layout>
