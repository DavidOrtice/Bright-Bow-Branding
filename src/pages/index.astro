---
import Layout from './layouts/Layout.astro';
---

<Layout title="Bright Bow | Premium Branding & Printing">
	<!-- Navigation -->
	<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">
		<div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
			<a href="/" class="flex items-center gap-3 group">
				<div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg rounded-tr-none transition-transform group-hover:scale-105"></div>
				<span class="text-2xl font-bold tracking-tight text-gray-900">BRIGHT BOW</span>
			</a>
			<div class="hidden md:flex items-center gap-8">
				<a href="#services" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Services</a>
				<a href="#portfolio" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Portfolio</a>
				<a href="#about" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">About</a>
				<a href="https://wa.me/254748448431" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-full text-sm font-semibold transition-all hover:shadow-lg hover:shadow-orange-500/30">
					Get In Touch
				</a>
			</div>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-b from-white to-blue-50/30">
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-blob"></div>
			<div class="absolute -bottom-40 -left-40 w-96 h-96 bg-orange-100 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-blob animation-delay-2000"></div>
			<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-pink-100 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-blob animation-delay-4000"></div>
		</div>
		
		<div class="max-w-7xl mx-auto px-6 pt-32 pb-20 relative z-10">
			<div class="max-w-4xl">
				<div class="inline-block mb-6">
					<span class="text-xs font-bold tracking-widest uppercase text-blue-600 bg-blue-50 px-4 py-2 rounded-full">
						Est. 2020 • Nairobi, Kenya
					</span>
				</div>
				<h1 class="text-7xl md:text-8xl lg:text-9xl font-black leading-none mb-8 tracking-tight">
					<span class="text-gray-900 block">Vivid Identity.</span>
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-blue-700 to-blue-800">Precision Print.</span>
				</h1>
				<p class="text-xl md:text-2xl text-gray-600 max-w-2xl leading-relaxed mb-12 font-light">
					We transform businesses into unforgettable brands. From strategy to execution, 
					we craft visual identities that command attention and inspire trust.
				</p>
				<div class="flex flex-wrap gap-4 mb-16">
					<a href="#portfolio" class="bg-gray-900 text-white px-8 py-4 rounded-full font-semibold hover:bg-gray-800 transition-all hover:shadow-xl hover:shadow-gray-900/20 flex items-center gap-2">
						View Our Work
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
					<a href="#services" class="border-2 border-gray-900 text-gray-900 px-8 py-4 rounded-full font-semibold hover:bg-gray-900 hover:text-white transition-all">
						Our Services
					</a>
				</div>
				
				<!-- Brand Marks -->
				<div class="flex gap-4">
					<div class="w-16 h-16 bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-full animate-float"></div>
					<div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-pink-600 rounded-tl-full rounded-br-full animate-float animation-delay-1000"></div>
					<div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-600 rounded-tr-full rounded-bl-full animate-float animation-delay-2000"></div>
				</div>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
			<svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
			</svg>
		</div>
	</section>

	<!-- Services Section -->
	<section id="services" class="py-32 bg-gray-900 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-900 to-blue-900/20"></div>
		
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<div class="text-center mb-20">
				<span class="text-xs font-bold tracking-widest uppercase text-blue-400 mb-4 block">What We Do</span>
				<h2 class="text-5xl md:text-6xl font-black text-white mb-6">Our Services</h2>
				<p class="text-xl text-gray-400 max-w-2xl mx-auto">
					Comprehensive branding solutions that elevate your business presence
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<!-- Service 1: Branding -->
				<div class="group relative bg-gradient-to-br from-gray-800 to-gray-900 p-10 rounded-3xl border border-gray-700 hover:border-blue-500 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-500/20 overflow-hidden">
					<div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-blue-500 to-blue-700"></div>
					<div class="absolute top-0 right-0 w-20 h-20 bg-blue-500/10 rounded-full -mr-10 -mt-10 group-hover:scale-150 transition-transform duration-500"></div>
					
					<div class="relative z-10">
						<div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl mb-6 flex items-center justify-center">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
							</svg>
						</div>
						<h3 class="text-3xl font-bold text-white mb-4">01. Branding</h3>
						<p class="text-gray-400 leading-relaxed mb-6">
							Complete brand identity systems including logo design, color palettes, typography, 
							and comprehensive brand guidelines that ensure consistency across all touchpoints.
						</p>
						<ul class="space-y-2 text-sm text-gray-500">
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
								Logo Design & Identity
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
								Brand Strategy
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>
								Visual Guidelines
							</li>
						</ul>
					</div>
				</div>

				<!-- Service 2: Printing -->
				<div class="group relative bg-gradient-to-br from-gray-800 to-gray-900 p-10 rounded-3xl border border-gray-700 hover:border-orange-500 transition-all duration-500 hover:shadow-2xl hover:shadow-orange-500/20 overflow-hidden">
					<div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-orange-500 to-orange-700"></div>
					<div class="absolute top-0 right-0 w-20 h-20 bg-orange-500/10 rounded-full -mr-10 -mt-10 group-hover:scale-150 transition-transform duration-500"></div>
					
					<div class="relative z-10">
						<div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-700 rounded-2xl mb-6 flex items-center justify-center">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
							</svg>
						</div>
						<h3 class="text-3xl font-bold text-white mb-4">02. Printing</h3>
						<p class="text-gray-400 leading-relaxed mb-6">
							Premium printing services with meticulous attention to detail. From business cards 
							to large-format displays, we deliver exceptional quality every time.
						</p>
						<ul class="space-y-2 text-sm text-gray-500">
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-orange-500 rounded-full"></div>
								Business Stationery
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-orange-500 rounded-full"></div>
								Large Format Printing
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-orange-500 rounded-full"></div>
								Promotional Materials
							</li>
						</ul>
					</div>
				</div>

				<!-- Service 3: Strategy -->
				<div class="group relative bg-gradient-to-br from-gray-800 to-gray-900 p-10 rounded-3xl border border-gray-700 hover:border-pink-500 transition-all duration-500 hover:shadow-2xl hover:shadow-pink-500/20 overflow-hidden">
					<div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-pink-500 to-pink-700"></div>
					<div class="absolute top-0 right-0 w-20 h-20 bg-pink-500/10 rounded-full -mr-10 -mt-10 group-hover:scale-150 transition-transform duration-500"></div>
					
					<div class="relative z-10">
						<div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-pink-700 rounded-2xl mb-6 flex items-center justify-center">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
							</svg>
						</div>
						<h3 class="text-3xl font-bold text-white mb-4">03. Strategy</h3>
						<p class="text-gray-400 leading-relaxed mb-6">
							Strategic brand positioning and market analysis to ensure your brand stands out 
							in competitive markets and resonates with your target audience.
						</p>
						<ul class="space-y-2 text-sm text-gray-500">
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
								Market Research
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
								Brand Positioning
							</li>
							<li class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 bg-pink-500 rounded-full"></div>
								Competitive Analysis
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Portfolio Section -->
	<section id="portfolio" class="py-32 bg-white">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-20">
				<span class="text-xs font-bold tracking-widest uppercase text-blue-600 mb-4 block">Our Work</span>
				<h2 class="text-5xl md:text-6xl font-black text-gray-900 mb-6">Portfolio</h2>
				<p class="text-xl text-gray-600 max-w-2xl mx-auto">
					A showcase of brands we've brought to life
				</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<!-- Portfolio Item 1 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-blue-600/90 to-blue-800/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Corporate Identity</h3>
							<p class="text-blue-100 text-sm mb-4">Full branding package for financial services</p>
							<span class="text-xs uppercase tracking-wider text-blue-200">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center">
						<div class="text-white text-6xl font-black">01</div>
					</div>
				</div>

				<!-- Portfolio Item 2 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-orange-600/90 to-orange-800/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Restaurant Branding</h3>
							<p class="text-orange-100 text-sm mb-4">Menu design & signage for upscale dining</p>
							<span class="text-xs uppercase tracking-wider text-orange-200">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center">
						<div class="text-white text-6xl font-black">02</div>
					</div>
				</div>

				<!-- Portfolio Item 3 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-pink-600/90 to-pink-800/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Tech Startup</h3>
							<p class="text-pink-100 text-sm mb-4">Brand identity for innovative tech company</p>
							<span class="text-xs uppercase tracking-wider text-pink-200">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-pink-500 to-pink-700 flex items-center justify-center">
						<div class="text-white text-6xl font-black">03</div>
					</div>
				</div>

				<!-- Portfolio Item 4 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-yellow-600/90 to-yellow-800/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Event Branding</h3>
							<p class="text-yellow-100 text-sm mb-4">Complete visual identity for annual conference</p>
							<span class="text-xs uppercase tracking-wider text-yellow-200">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center">
						<div class="text-white text-6xl font-black">04</div>
					</div>
				</div>

				<!-- Portfolio Item 5 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-blue-600/90 to-purple-800/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Retail Packaging</h3>
							<p class="text-purple-100 text-sm mb-4">Premium packaging design for beauty brand</p>
							<span class="text-xs uppercase tracking-wider text-purple-200">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-blue-600 to-purple-700 flex items-center justify-center">
						<div class="text-white text-6xl font-black">05</div>
					</div>
				</div>

				<!-- Portfolio Item 6 -->
				<div class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square cursor-pointer">
					<div class="absolute inset-0 bg-gradient-to-br from-gray-700/90 to-gray-900/90 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
						<div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
							<h3 class="text-2xl font-bold mb-2">Real Estate</h3>
							<p class="text-gray-200 text-sm mb-4">Luxury property branding & marketing materials</p>
							<span class="text-xs uppercase tracking-wider text-gray-300">View Project →</span>
						</div>
					</div>
					<div class="w-full h-full bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center">
						<div class="text-white text-6xl font-black">06</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- About/Trust Section -->
	<section id="about" class="py-32 bg-gradient-to-b from-gray-50 to-white">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid lg:grid-cols-2 gap-16 items-center">
				<div>
					<span class="text-xs font-bold tracking-widest uppercase text-blue-600 mb-4 block">About Us</span>
					<h2 class="text-5xl font-black text-gray-900 mb-6 leading-tight">
						Crafting Brands That Stand Out
					</h2>
					<div class="space-y-6 text-lg text-gray-600 leading-relaxed">
						<p>
							Since 2020, Bright Bow has been Nairobi's premier destination for businesses seeking 
							to elevate their brand presence. We combine strategic thinking with creative excellence 
							to deliver identities that resonate.
						</p>
						<p>
							Our team brings together expertise in brand strategy, visual design, and premium printing 
							to offer comprehensive solutions that transform businesses into memorable brands.
						</p>
						<p>
							We believe that every business deserves a brand that reflects its unique value proposition. 
							From startups to established enterprises, we create visual identities that command attention 
							and build lasting connections with audiences.
						</p>
					</div>
					<div class="mt-10 grid grid-cols-3 gap-8">
						<div>
							<div class="text-4xl font-black text-blue-600 mb-2">200+</div>
							<div class="text-sm text-gray-600">Projects Completed</div>
						</div>
						<div>
							<div class="text-4xl font-black text-orange-500 mb-2">150+</div>
							<div class="text-sm text-gray-600">Happy Clients</div>
						</div>
						<div>
							<div class="text-4xl font-black text-pink-500 mb-2">5+</div>
							<div class="text-sm text-gray-600">Years Experience</div>
						</div>
					</div>
				</div>
				<div class="relative">
					<div class="aspect-square rounded-3xl bg-gradient-to-br from-blue-100 to-orange-50 p-12 flex items-center justify-center">
						<div class="space-y-6 w-full">
							<div class="bg-white rounded-2xl p-6 shadow-xl transform rotate-2 hover:rotate-0 transition-transform">
								<div class="flex items-center gap-4 mb-4">
									<div class="w-12 h-12 bg-blue-600 rounded-xl"></div>
									<div class="flex-1">
										<div class="h-3 bg-gray-200 rounded w-3/4 mb-2"></div>
										<div class="h-2 bg-gray-100 rounded w-1/2"></div>
									</div>
								</div>
								<div class="space-y-2">
									<div class="h-2 bg-gray-100 rounded"></div>
									<div class="h-2 bg-gray-100 rounded w-5/6"></div>
								</div>
							</div>
							<div class="bg-white rounded-2xl p-6 shadow-xl transform -rotate-2 hover:rotate-0 transition-transform">
								<div class="flex items-center gap-4 mb-4">
									<div class="w-12 h-12 bg-orange-500 rounded-xl"></div>
									<div class="flex-1">
										<div class="h-3 bg-gray-200 rounded w-2/3 mb-2"></div>
										<div class="h-2 bg-gray-100 rounded w-1/3"></div>
									</div>
								</div>
								<div class="space-y-2">
									<div class="h-2 bg-gray-100 rounded"></div>
									<div class="h-2 bg-gray-100 rounded w-4/5"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-32 bg-gray-900 relative overflow-hidden">
		<div class="absolute inset-0">
			<div class="absolute top-0 right-0 w-1/2 h-1/2 bg-blue-600/10 rounded-full blur-3xl"></div>
			<div class="absolute bottom-0 left-0 w-1/2 h-1/2 bg-orange-600/10 rounded-full blur-3xl"></div>
		</div>
		
		<div class="max-w-4xl mx-auto px-6 text-center relative z-10">
			<h2 class="text-5xl md:text-6xl font-black text-white mb-6">
				Ready to Transform Your Brand?
			</h2>
			<p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
				Let's create something extraordinary together. Get in touch and let's discuss how we can 
				elevate your brand to new heights.
			</p>
