---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow | Premium Branding & Printing">

<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap');

:root {
    --primary-blue: #0055a5;
    --accent-orange: #f5821f;
    --accent-pink: #c2185b;
    --accent-yellow: #ffcd00;
    --accent-gold: #d4af37;
    --dark: #1f2732;
    --gray: #4a5568;
    --light-gray: #f3f4f6;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background: #ffffff;
    color: var(--dark);
    overflow-x: hidden;
}

html {
    scroll-behavior: smooth;
}

/* =========================
   NAVIGATION
========================= */

.nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--dark);
}

/* ===== REFINED ICON ===== */

.logo-icon {
    position: relative;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
}

.logo-icon .blue {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--primary-blue);
    top: 0;
    left: 0;
    border-bottom-right-radius: 18px;
}

.logo-icon .orange {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--accent-orange);
    top: 0;
    right: 0;
}

.logo-icon .yellow {
    position: absolute;
    width: 100%;
    height: 50%;
    background: var(--accent-yellow);
    bottom: 0;
    left: 0;
    border-top-left-radius: 22px;
}

.logo-icon .pink {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--accent-pink);
    top: 0;
    right: 0;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
}

.logo-text-wrapper {
    display: flex;
    flex-direction: column;
}

.logo-bright {
    font-size: 15px;
    font-weight: 700;
}

.logo-bow {
    font-size: 17px;
    font-weight: 700;
    margin-top: -3px;
}

.logo-tagline {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--gray);
    text-transform: uppercase;
    margin-top: 4px;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 2rem 4rem;
}

.hero-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
}

.hero-title {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -2px;
    margin-bottom: 1.5rem;
}

.hero-title .highlight {
    color: var(--primary-blue);
}

.hero-subtitle {
    font-family: 'Crimson Pro', serif;
    font-size: 1.4rem;
    color: var(--gray);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 3rem;
    font-style: italic;
}

/* HERO ICON */

.hero-logo-large {
    display: flex;
    align-items: center;
    gap: 32px;
}

.hero-icon {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 28px;
    overflow: hidden;
}

.hero-icon .blue {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--primary-blue);
    top: 0;
    left: 0;
    border-bottom-right-radius: 55px;
}

.hero-icon .orange {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--accent-orange);
    top: 0;
    right: 0;
}

.hero-icon .yellow {
    position: absolute;
    width: 100%;
    height: 50%;
    background: var(--accent-yellow);
    bottom: 0;
    left: 0;
    border-top-left-radius: 60px;
}

.hero-icon .pink {
    position: absolute;
    width: 50%;
    height: 50%;
    background: var(--accent-pink);
    top: 0;
    right: 0;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
}

.hero-logo-large .bright {
    background: #f5f5f5;
    padding: 8px 18px;
    font-size: 44px;
    font-weight: 700;
    box-shadow: 0 4px 8px rgba(0,0,0,0.08);
    width: fit-content;
}

.hero-logo-large .bow {
    font-size: 52px;
    font-weight: 700;
    margin-top: 6px;
}

.hero-logo-large .subtitle {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-top: 10px;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 968px) {
    .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-logo-large {
        flex-direction: column;
        gap: 20px;
    }
}

</style>

<!-- =========================
     NAVBAR
========================= -->

<nav class="nav">
    <div class="nav-container">
        <a href="#" class="logo">
            <div class="logo-icon">
                <div class="blue"></div>
                <div class="orange"></div>
                <div class="yellow"></div>
                <div class="pink"></div>
            </div>
            <div class="logo-text-wrapper">
                <div class="logo-bright">BRIGHT</div>
                <div class="logo-bow">BOW</div>
                <div class="logo-tagline">Branding & Printing</div>
            </div>
        </a>
    </div>
</nav>

<!-- =========================
     HERO
========================= -->

<section class="hero">
    <div class="hero-container">

        <div>
            <h1 class="hero-title">
                Vivid Identity.<br>
                <span class="highlight">Precision</span> Print.
            </h1>

            <p class="hero-subtitle">
                Transforming business infrastructure into visual landmarks.
                From Nairobi to the world, we craft brands that command attention.
            </p>
        </div>

        <div class="hero-logo-large">
            <div class="hero-icon">
                <div class="blue"></div>
                <div class="orange"></div>
                <div class="yellow"></div>
                <div class="pink"></div>
            </div>

            <div class="text-area">
                <div class="bright">BRIGHT</div>
                <div class="bow">BOW</div>
                <div class="subtitle">BRANDING & PRINTING</div>
            </div>
        </div>

    </div>
</section>

</Layout>
