---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow | Premium Branding & Printing">
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap');
		
		:root {
			--primary-blue: #0055a5;
			--accent-orange: #f5821f;
			--accent-pink: #c2185b;
			--accent-yellow: #ffcd00;
			--dark: #1f2732;
			--gray: #4a5568;
			--light-gray: #f3f4f6;
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background: #ffffff;
			color: var(--dark);
			overflow-x: hidden;
		}

		html {
			scroll-behavior: smooth;
		}

		.nav {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 1000;
			background: rgba(255, 255, 255, 0.85);
			backdrop-filter: blur(20px);
			border-bottom: 1px solid rgba(0, 71, 171, 0.1);
			animation: slideDown 0.6s ease-out;
		}

		@keyframes slideDown {
			from {
				transform: translateY(-100%);
				opacity: 0;
			}
			to {
				transform: translateY(0);
				opacity: 1;
			}
		}

		.nav-container {
			max-width: 1400px;
			margin: 0 auto;
			padding: 1.5rem 2rem;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.logo {
			display: block;
			text-decoration: none;
		}

		.logo img {
			height: 60px;
			width: auto;
		}

		.nav-links {
			display: flex;
			gap: 2.5rem;
			align-items: center;
		}

		.nav-link {
			text-decoration: none;
			color: var(--gray);
			font-size: 0.875rem;
			font-weight: 600;
			letter-spacing: 0.5px;
			text-transform: uppercase;
			transition: color 0.3s ease;
		}

		.nav-link:hover {
			color: var(--primary-blue);
		}

		.cta-button {
			background: var(--accent-orange);
			color: white;
			padding: 0.875rem 1.75rem;
			border-radius: 50px;
			text-decoration: none;
			font-weight: 700;
			font-size: 0.875rem;
			letter-spacing: 0.5px;
			transition: all 0.3s ease;
			box-shadow: 0 4px 14px rgba(255, 69, 0, 0.3);
		}

		.cta-button:hover {
			background: #ff3300;
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(255, 69, 0, 0.4);
		}

		.hero {
			min-height: 100vh;
			display: flex;
			align-items: center;
			padding: 8rem 2rem 4rem;
			position: relative;
			overflow: hidden;
		}

		.hero-background {
			position: absolute;
			top: 0;
			right: -15%;
			width: 70%;
			height: 100%;
			background: linear-gradient(135deg, rgba(0, 71, 171, 0.03) 0%, rgba(255, 215, 0, 0.05) 100%);
			border-radius: 300px 0 300px 300px;
			z-index: 0;
			animation: float 20s ease-in-out infinite;
		}

		@keyframes float {
			0%, 100% {
				transform: translateY(0) rotate(0deg);
			}
			50% {
				transform: translateY(-30px) rotate(2deg);
			}
		}

		.hero-container {
			max-width: 1400px;
			margin: 0 auto;
			position: relative;
			z-index: 2;
			display: grid;
			grid-template-columns: 1.2fr 1fr;
			gap: 4rem;
			align-items: center;
		}

		.hero-content {
			animation: fadeInUp 0.8s ease-out 0.2s both;
		}

		@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(30px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.hero-title {
			font-size: clamp(3rem, 7vw, 6.5rem);
			font-weight: 900;
			line-height: 0.95;
			letter-spacing: -3px;
			margin-bottom: 1.5rem;
		}

		.hero-title .highlight {
			color: var(--primary-blue);
			position: relative;
			display: inline-block;
		}

		.hero-subtitle {
			font-family: 'Crimson Pro', serif;
			font-size: clamp(1.25rem, 2.5vw, 1.75rem);
			color: var(--gray);
			line-height: 1.6;
			max-width: 600px;
			margin-bottom: 3rem;
			font-style: italic;
		}

		.hero-shapes {
			display: flex;
			gap: 1.25rem;
			animation: fadeInUp 0.8s ease-out 0.4s both;
		}

		.shape {
			width: 80px;
			height: 80px;
			transition: transform 0.4s ease;
		}

		.shape:hover {
			transform: scale(1.1) rotate(5deg);
		}

		.shape-1 {
			background: var(--accent-yellow);
			border-radius: 50%;
		}

		.shape-2 {
			background: var(--accent-pink);
			border-radius: 0 40px 40px 40px;
		}

		.shape-3 {
			background: var(--accent-orange);
			border-radius: 40px 40px 0 40px;
		}

		.hero-visual {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			animation: fadeInUp 0.8s ease-out 0.6s both;
		}

		.hero-logo-large {
			animation: fadeInScale 1s ease-out 0.6s both;
		}

		.hero-logo-large img {
			width: 100%;
			height: auto;
			max-width: 900px;
			filter: drop-shadow(0 20px 40px rgba(0,0,0,0.08));
			/* Remove background if image has one */
			mix-blend-mode: darken;
		}

		.services {
			padding: 8rem 2rem;
			background: var(--dark);
			color: white;
			position: relative;
		}

		.services::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background: linear-gradient(90deg, transparent, var(--primary-blue), transparent);
		}

		.services-container {
			max-width: 1400px;
			margin: 0 auto;
		}

		.section-label {
			font-size: 0.875rem;
			font-weight: 700;
			letter-spacing: 3px;
			text-transform: uppercase;
			color: var(--accent-orange);
			margin-bottom: 1rem;
			opacity: 0;
			animation: fadeInUp 0.8s ease-out forwards;
		}

		.section-title {
			font-size: clamp(2.5rem, 5vw, 4rem);
			font-weight: 900;
			letter-spacing: -2px;
			margin-bottom: 5rem;
			opacity: 0;
			animation: fadeInUp 0.8s ease-out 0.1s forwards;
		}

		.services-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 3rem;
		}

		.service-card {
			border-left: 3px solid;
			padding-left: 2rem;
			transition: all 0.4s ease;
			opacity: 0;
			animation: fadeInUp 0.8s ease-out forwards;
		}

		.service-card:nth-child(1) {
			border-color: var(--primary-blue);
			animation-delay: 0.2s;
		}

		.service-card:nth-child(2) {
			border-color: var(--accent-orange);
			animation-delay: 0.3s;
		}

		.service-card:nth-child(3) {
			border-color: var(--accent-pink);
			animation-delay: 0.4s;
		}

		.service-card:hover {
			transform: translateX(10px);
		}

		.service-number {
			font-size: 3.5rem;
			font-weight: 900;
			line-height: 1;
			margin-bottom: 1rem;
			opacity: 0.3;
		}

		.service-card:nth-child(1) .service-number {
			color: var(--primary-blue);
		}

		.service-card:nth-child(2) .service-number {
			color: var(--accent-orange);
		}

		.service-card:nth-child(3) .service-number {
			color: var(--accent-pink);
		}

		.service-title {
			font-size: 2rem;
			font-weight: 700;
			margin-bottom: 1rem;
		}

		.service-description {
			color: #9ca3af;
			line-height: 1.7;
			font-size: 1.05rem;
		}

		.service-features {
			list-style: none;
			margin-top: 1.5rem;
		}

		.service-features li {
			padding: 0.5rem 0;
			color: #d1d5db;
			position: relative;
			padding-left: 1.5rem;
		}

		.service-features li::before {
			content: '→';
			position: absolute;
			left: 0;
			opacity: 0.5;
		}

		.portfolio {
			padding: 8rem 2rem;
			background: white;
		}

		.portfolio-container {
			max-width: 1400px;
			margin: 0 auto;
		}

		.portfolio-header {
			text-align: center;
			margin-bottom: 5rem;
		}

		.portfolio-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
			gap: 2rem;
		}

		.portfolio-item {
			position: relative;
			aspect-ratio: 4/5;
			background: var(--light-gray);
			border-radius: 16px;
			overflow: hidden;
			cursor: pointer;
			transition: transform 0.4s ease;
		}

		.portfolio-item:hover {
			transform: scale(1.02);
		}

		.portfolio-item img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.4s ease;
		}

		.portfolio-item:hover img {
			transform: scale(1.05);
		}

		.portfolio-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 2rem;
			opacity: 0;
			transition: opacity 0.4s ease;
		}

		.portfolio-item:hover .portfolio-overlay {
			opacity: 1;
		}

		.portfolio-title {
			font-size: 1.5rem;
			font-weight: 700;
			color: white;
			margin-bottom: 0.5rem;
		}

		.portfolio-category {
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 2px;
			text-transform: uppercase;
			color: var(--accent-yellow);
		}

		.process {
			padding: 8rem 2rem;
			background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
		}

		.process-container {
			max-width: 1200px;
			margin: 0 auto;
		}

		.process-steps {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 3rem;
			margin-top: 4rem;
		}

		.process-step {
			text-align: center;
			position: relative;
		}

		.step-icon {
			width: 100px;
			height: 100px;
			margin: 0 auto 2rem;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 2.5rem;
			font-weight: 900;
			color: white;
			position: relative;
		}

		.process-step:nth-child(1) .step-icon {
			background: linear-gradient(135deg, var(--primary-blue), #0056d6);
		}

		.process-step:nth-child(2) .step-icon {
			background: linear-gradient(135deg, var(--accent-orange), #ff6633);
		}

		.process-step:nth-child(3) .step-icon {
			background: linear-gradient(135deg, var(--accent-pink), #f43f5e);
		}

		.process-step:nth-child(4) .step-icon {
			background: linear-gradient(135deg, var(--accent-yellow), #ffd700);
			color: var(--dark);
		}

		.step-title {
			font-size: 1.25rem;
			font-weight: 700;
			margin-bottom: 0.75rem;
		}

		.step-description {
			color: var(--gray);
			line-height: 1.6;
		}

		.contact {
			padding: 8rem 2rem;
			background: var(--dark);
			color: white;
			text-align: center;
		}

		.contact-container {
			max-width: 800px;
			margin: 0 auto;
		}

		.contact-title {
			font-size: clamp(2.5rem, 5vw, 4.5rem);
			font-weight: 900;
			letter-spacing: -2px;
			margin-bottom: 2rem;
		}

		.contact-subtitle {
			font-family: 'Crimson Pro', serif;
			font-size: 1.5rem;
			color: #9ca3af;
			margin-bottom: 3rem;
			font-style: italic;
		}

		.contact-buttons {
			display: flex;
			gap: 1.5rem;
			justify-content: center;
			flex-wrap: wrap;
		}

		.contact-button {
			padding: 1.25rem 2.5rem;
			border-radius: 50px;
			text-decoration: none;
			font-weight: 700;
			font-size: 1rem;
			letter-spacing: 0.5px;
			transition: all 0.3s ease;
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
		}

		.contact-button.primary {
			background: var(--accent-orange);
			color: white;
			box-shadow: 0 4px 14px rgba(255, 69, 0, 0.3);
		}

		.contact-button.primary:hover {
			background: #ff3300;
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(255, 69, 0, 0.4);
		}

		.contact-button.secondary {
			background: transparent;
			color: white;
			border: 2px solid rgba(255, 255, 255, 0.2);
		}

		.contact-button.secondary:hover {
			background: rgba(255, 255, 255, 0.1);
			border-color: rgba(255, 255, 255, 0.4);
		}

		.footer {
			padding: 3rem 2rem;
			background: #000000;
			color: #6b7280;
			text-align: center;
			border-top: 1px solid rgba(255, 255, 255, 0.05);
		}

		.footer-content {
			max-width: 1400px;
			margin: 0 auto;
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 2rem;
		}

		.footer-logo {
			font-weight: 900;
			font-size: 1.25rem;
			color: white;
		}

		.footer-links {
			display: flex;
			gap: 2rem;
		}

		.footer-link {
			color: #9ca3af;
			text-decoration: none;
			font-size: 0.875rem;
			transition: color 0.3s ease;
		}

		.footer-link:hover {
			color: var(--accent-orange);
		}

		.footer-copy {
			font-size: 0.875rem;
		}

		@media (max-width: 968px) {
			.hero-container {
				grid-template-columns: 1fr;
				gap: 3rem;
			}

			.hero-logo-large img {
				max-width: 700px;
			}

			.nav-container {
				flex-wrap: wrap;
			}

			.nav-links {
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			.nav-link {
				font-size: 0.75rem;
			}

			.cta-button {
				padding: 0.75rem 1.5rem;
				font-size: 0.75rem;
			}

			.portfolio-grid {
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			}

			.footer-content {
				flex-direction: column;
				text-align: center;
			}
		}

		@media (max-width: 640px) {
			.hero-logo-large img {
				max-width: 500px;
			}

			.logo img {
				height: 50px;
			}

			.nav-container {
				padding: 1rem;
			}

			.nav-links {
				gap: 1rem;
				width: 100%;
				justify-content: center;
			}

			.nav-link {
				font-size: 0.65rem;
			}

			.cta-button {
				padding: 0.65rem 1.25rem;
				font-size: 0.65rem;
			}

			.hero-shapes {
				gap: 0.75rem;
			}

			.shape {
				width: 60px;
				height: 60px;
			}

			.contact-buttons {
				flex-direction: column;
			}

			.contact-button {
				width: 100%;
				justify-content: center;
			}
		}
	</style>

	<nav class="nav">
		<div class="nav-container">
			<a href="#" class="logo">
				<img src="/bright-bow-logo-small.png" alt="Bright Bow" />
			</a>
			<div class="nav-links">
				<a href="#services" class="nav-link">Services</a>
				<a href="#portfolio" class="nav-link">Portfolio</a>
				<a href="#process" class="nav-link">Process</a>
				<a href="#contact" class="cta-button">Get Started</a>
			</div>
		</div>
	</nav>

	<section class="hero">
		<div class="hero-background"></div>
		<div class="hero-container">
			<div class="hero-content">
				<h1 class="hero-title">
					Vivid Identity.<br>
					<span class="highlight">Precision</span> Print.
				</h1>
				<p class="hero-subtitle">
					Transforming business infrastructure into visual landmarks. From Nairobi to the world, we craft brands that command attention and inspire confidence.
				</p>
				<div class="hero-shapes">
					<div class="shape shape-1"></div>
					<div class="shape shape-2"></div>
					<div class="shape shape-3"></div>
				</div>
			</div>
			<div class="hero-visual">
				<div class="hero-logo-large">
					<img src="/bright-bow-logo.png" alt="Bright Bow - Branding & Printing" />
				</div>
			</div>
		</div>
	</section>

	<section id="services" class="services">
		<div class="services-container">
			<div class="section-label">What We Do</div>
			<h2 class="section-title">Services That Elevate</h2>
			<div class="services-grid">
				<div class="service-card">
					<div class="service-number">01</div>
					<h3 class="service-title">Brand Identity</h3>
					<p class="service-description">
						We architect comprehensive visual identity systems that position your enterprise for sustainable growth and market dominance.
					</p>
					<ul class="service-features">
						<li>Logo Design & Brand Guidelines</li>
						<li>Corporate Identity Systems</li>
						<li>Brand Strategy & Positioning</li>
						<li>Visual Language Development</li>
					</ul>
				</div>
				<div class="service-card">
					<div class="service-number">02</div>
					<h3 class="service-title">Premium Printing</h3>
					<p class="service-description">
						High-fidelity production with meticulous attention to material selection, ensuring every touchpoint reflects excellence.
					</p>
					<ul class="service-features">
						<li>Business Cards & Stationery</li>
						<li>Marketing Collateral</li>
						<li>Packaging & Product Labels</li>
						<li>Large Format Printing</li>
					</ul>
				</div>
				<div class="service-card">
					<div class="service-number">03</div>
					<h3 class="service-title">Strategic Design</h3>
					<p class="service-description">
						Expert consultancy for brand positioning in competitive markets, backed by research and strategic thinking.
					</p>
					<ul class="service-features">
						<li>Market Research & Analysis</li>
						<li>Competitive Positioning</li>
						<li>Brand Audits & Refresh</li>
						<li>Digital Brand Extensions</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="portfolio" class="portfolio">
		<div class="portfolio-container">
			<div class="portfolio-header">
				<div class="section-label">Selected Works</div>
				<h2 class="section-title">Portfolio Showcase</h2>
			</div>
			<div class="portfolio-grid">
				<div class="portfolio-item">
					<img src="/Bespoke Vow Books Kenya.jpg" alt="Bespoke Vow Books Kenya" onerror="this.src='/api/placeholder/500/625'">
					<div class="portfolio-overlay">
						<h3 class="portfolio-title">Bespoke Vow Books</h3>
						<p class="portfolio-category">Wedding Stationery</p>
					</div>
				</div>
				<div class="portfolio-item">
					<img src="/Custom Wax Seal Design Kenya.jpg" alt="Custom Wax Seal Design Kenya" onerror="this.src='/api/placeholder/500/625'">
					<div class="portfolio-overlay">
						<h3 class="portfolio-title">Custom Wax Seal Design</h3>
						<p class="portfolio-category">Luxury Stationery</p>
					</div>
				</div>
				<div class="portfolio-item">
					<img src="/Executive Corporate Gifting Nairobi.jpg" alt="Executive Corporate Gifting Nairobi" onerror="this.src='/api/placeholder/500/625'">
					<div class="portfolio-overlay">
						<h3 class="portfolio-title">Executive Corporate Gifting</h3>
						<p class="portfolio-category">Corporate Gifts</p>
					</div>
				</div>
				<div class="portfolio-item">
					<img src="/Luxury Wedding Invitations Nairobi.jpg" alt="Luxury Wedding Invitations Nairobi" onerror="this.src='/api/placeholder/500/625'">
					<div class="portfolio-overlay">
						<h3 class="portfolio-title">Luxury Wedding Invitations</h3>
						<p class="portfolio-category">Wedding Stationery</p>
					</div>
				</div>
				<div class="portfolio-item">
					<img src="/src="/branded-mugs-nairobi-kenya.jpg" alt="Premium branded mugs and customized cups in Nairobi Kenya">
					<div class="portfolio-overlay">
						<h3 class="portfolio-title">Customized branded Mugs</h3>
						<p class="portfolio-category">Branded Mugs</p>
					</div>
				</div>
				<div class="portfolio-item">
					<img src="/luxury-custom-wax-seals-nairobi-kenya.jpg" alt="Bespoke custom wax seal stamps and personalized wax stickers for luxury wedding invitations and corporate branding in Nairobi Kenya">
