---
/* NO IMPORTS - Testing if basic HTML renders */
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bright Bow Branding</title>
</head>
<body style="margin:0; padding:0; background-color: white; font-family: sans-serif;">

    <div style="height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
        
        <div style="display: grid; grid-template-columns: 80px 80px; gap: 5px; margin-bottom: 30px;">
            <div style="width: 80px; height: 80px; background-color: #0047AB; border-top-left-radius: 40px;"></div>
            <div style="width: 80px; height: 80px; background-color: #FF4500;"></div>
            <div style="width: 80px; height: 80px; background-color: #FFD700;"></div>
            <div style="width: 80px; height: 80px; background-color: #E11D48; border-bottom-right-radius: 40px;"></div>
        </div>

        <h1 style="font-size: 60px; font-weight: 900; margin: 0; color: #1A1A1A; line-height: 1;">
            BRIGHT <br> <span style="color: #0047AB;">BOW</span>
        </h1>
        
        <p style="letter-spacing: 10px; font-weight: bold; color: #888; margin-top: 20px;">
            BRANDING & PRINTING
        </p>

        <div style="margin-top: 40px;">
            <a href="https://wa.me/254..." style="background-color: #FF4500; color: white; padding: 15px 30px; text-decoration: none; font-weight: bold; text-transform: uppercase;">
                Contact Us
            </a>
        </div>
    </div>

    <div style="display: flex; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px; height: 200px; background-color: #0047AB; color: white; padding: 20px; font-weight: bold;">IDENTITY</div>
        <div style="flex: 1; min-width: 200px; height: 200px; background-color: #FF4500; color: white; padding: 20px; font-weight: bold;">PRINTING</div>
        <div style="flex: 1; min-width: 200px; height: 200px; background-color: #FFD700; color: black; padding: 20px; font-weight: bold;">DESIGN</div>
        <div style="flex: 1; min-width: 200px; height: 200px; background-color: #E11D48; color: white; padding: 20px; font-weight: bold;">GIFTS</div>
    </div>

</body>
</html>
