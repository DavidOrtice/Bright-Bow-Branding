---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bright Bow Branding | Design & Printing">
  <nav class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 px-6 md:px-24 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 flex">
        <div class="w-1/2 h-full bg-[#0047AB]"></div> <div class="w-1/2 h-full bg-[#FF4500]"></div> </div>
      <span class="text-xl font-black tracking-tighter text-[#1A1A1A] uppercase">Bright Bow</span>
    </div>
    
    <div class="hidden md:flex space-x-8 text-[11px] font-black uppercase tracking-widest text-gray-500">
      <a href="#services" class="hover:text-[#0047AB] transition">Services</a>
      <a href="#work" class="hover:text-[#0047AB] transition">Portfolio</a>
      <a href="#about" class="hover:text-[#0047AB] transition">Studio</a>
      <a href="#contact" class="bg-[#0047AB] text-white px-5 py-2 rounded-sm shadow-lg shadow-blue-200">Start Project</a>
    </div>
  </nav>

  <main>
    <section id="home" class="pt-48 pb-24 px-6 md:px-24 bg-white text-center md:text-left">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-6xl md:text-[100px] font-black leading-[0.85] tracking-tighter text-[#1A1A1A] uppercase mb-8">
            Vivid <br/> <span class="text-[#0047AB]">Printing.</span> <br/> <span class="text-[#FF4500]">Branding.</span>
          </h1>
          <p class="text-xl font-bold text-gray-500 max-w-lg mb-10 uppercase tracking-tight">
            We bring color to your business identity. Based in Nairobi, serving visionaries.
          </p>
          <a href="#services" class="inline-block border-4 border-[#1A1A1A] px-10 py-4 font-black uppercase tracking-widest hover:bg-[#1A1A1A] hover:text-white transition">Explore Our Work</a>
        </div>
        <div class="grid grid-cols-2 gap-2 max-w-md mx-auto md:mx-0">
          <div class="aspect-square bg-[#0047AB] rounded-tl-[100px]"></div>
          <div class="aspect-square bg-[#FF4500]"></div>
          <div class="aspect-square bg-[#FFD700]"></div>
          <div class="aspect-square bg-[#E11D48] rounded-br-[100px]"></div>
        </div>
      </div>
    </section>

    <section id="services" class="py-32 px-6 md:px-24 bg-gray-50 scroll-mt-20">
      <h2 class="text-xs font-black uppercase tracking-[0.5em] text-[#0047AB] mb-16">Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-[#0047AB] p-8 text-white">
          <h3 class="text-2xl font-black uppercase mb-4">Branding</h3>
          <p class="text-sm opacity-80">Full visual identity systems that demand attention.</p>
        </div>
        <div class="bg-[#FF4500] p-8 text-white">
          <h3 class="text-2xl font-black uppercase mb-4">Printing</h3>
          <p class="text-sm opacity-80">High-fidelity print solutions for executive stationery.</p>
        </div>
        <div class="bg-[#FFD700] p-8 text-black">
          <h3 class="text-2xl font-black uppercase mb-4">Design</h3>
          <h3 class="text-2xl font-black uppercase mb-4">Design</h3>
          <p class="text-sm opacity-80">Strategic creative direction for modern enterprises.</p>
        </div>
        <div class="bg-[#E11D48] p-8 text-white">
          <h3 class="text-2xl font-black uppercase mb-4">Objects</h3>
          <p class="text-sm opacity-80">Bespoke corporate gifting and custom merchandise.</p>
        </div>
      </div>
    </section>

    <section id="work" class="py-32 px-6 md:px-24 bg-white scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-6">
          <div class="aspect-video bg-gray-100 overflow-hidden border-8 border-gray-100">
            <img src="/wedding-stationery-nairobi.jpg" class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-500" />
          </div>
          <h4 class="text-3xl font-black uppercase tracking-tighter">Event Branding</h4>
        </div>
        <div class="space-y-6 md:mt-24">
          <div class="aspect-video bg-gray-100 overflow-hidden border-8 border-gray-100">
            <img src="/corporate-gifts-kenya.jpg" class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-500" />
          </div>
          <h4 class="text-3xl font-black uppercase tracking-tighter">Corporate Gifting</h4>
        </div>
      </div>
    </section>

    <section id="contact" class="py-32 px-6 md:px-24 bg-[#1A1A1A] text-white scroll-mt-20 text-center">
      <h2 class="text-5xl md:text-8xl font-black uppercase tracking-tighter mb-12">Ready to <br/> go <span class="text-[#FF4500]">Bright?</span></h2>
      <a href="https://wa.me/254..." class="inline-block bg-[#0047AB] px-12 py-6 text-xl font-black uppercase tracking-widest shadow-2xl shadow-blue-500/20">Talk to us</a>
    </section>
  </main>

  <footer class="p-12 text-center text-[10px] font-black uppercase tracking-[0.4em] text-gray-400">
    © 2026 Bright Bow Branding & Printing. All Gas, No Brakes.
  </footer>
</Layout>
