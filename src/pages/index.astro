---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ateliér | Quiet Authority">
  <nav class="fixed w-full z-50 p-8 flex justify-between mix-blend-difference text-white">
    <span class="text-2xl font-serif tracking-tighter uppercase">Ateliér</span>
    <div class="space-x-8 text-[10px] tracking-[0.3em] uppercase">
      <a href="#work" class="hover:opacity-50 transition">Work</a>
      <a href="/journal" class="hover:opacity-50 transition">Journal</a>
      <a href="https://wa.me/2547XXXXXXXX" class="hover:opacity-50 transition">Commission</a>
    </div>
  </nav>

  <main>
    <section class="h-screen flex flex-col justify-center px-8 md:px-24 bg-[#F9F7F5]">
      <h1 class="text-7xl md:text-[120px] leading-[0.9] tracking-tighter mb-8 text-[#1A1A1A] font-serif">
        Quiet <br/> <span class="italic text-gray-400">Authority.</span>
      </h1>
      <p class="max-w-sm text-gray-500 uppercase text-[10px] tracking-[0.2em] leading-relaxed">
        Crafting the physical touchpoints of Nairobi’s most prestigious identities.
      </p>
    </section>

    <section id="work" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4">
      <div class="md:col-span-8 bg-gray-100 min-h-[500px] overflow-hidden group relative">
        <img 
          src="/wedding-stationery-nairobi.jpg" 
          alt="Bespoke Wedding Invitations Kenya" 
          class="object-cover w-full h-full transition duration-700 group-hover:scale-105" 
        />
        <div class="absolute bottom-6 left-6 text-white bg-black/20 p-4 backdrop-blur-sm">
          <p class="text-xs tracking-widest uppercase">The Mauve Suite</p>
        </div>
      </div>

      <div class="md:col-span-4 bg-[#1A1A1A] text-white p-12 flex flex-col justify-center">
        <h2 class="text-4xl mb-6 italic font-serif">Executive Gifts</h2>
        <p class="text-sm text-gray-400 leading-loose mb-8">Customized for the Kenyan corporate leader.</p>
        <img 
          src="/corporate-gifts-kenya.jpg" 
          alt="Executive Gifting Nairobi" 
          class="rounded-sm shadow-xl w-full h-auto grayscale hover:grayscale-0 transition duration-500" 
        />
      </div>
    </section>
  </main>
</Layout>
